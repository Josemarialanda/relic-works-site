{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev server",
      "type": "shell",
      "command": "nix develop -c npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "next",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting\\.\\.\\.",
          "endsPattern": "Ready in"
        }
      },
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Build",
      "type": "shell",
      "command": "nix develop -c npm run build",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Production server",
      "type": "shell",
      "command": "nix develop -c npm run start",
      "dependsOn": "Build",
      "isBackground": true,
      "problemMatcher": {
        "owner": "next",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting\\.\\.\\.",
          "endsPattern": "Ready in"
        }
      },
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "Test",
      "type": "shell",
      "command": "nix develop -c npm test",
      "problemMatcher": [],
      "presentation": { "reveal": "always" },
      "group": { "kind": "test", "isDefault": true }
    }
  ]
}
