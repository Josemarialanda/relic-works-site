# Copy this file to .env.local and fill in the value. Never commit .env.local.

# The secret key of your Stripe account. Use a test key (sk_test_...) for development and a live key
# (sk_live_...) only in the production environment of the host. Without it, the Checkout button shows
# "Checkout is not available yet."
STRIPE_SECRET_KEY=

# The address of the site, for the full link of the share image (no slash at the end). Set it for the
# production environment of the host. Without it, the build uses the Vercel production address.
NEXT_PUBLIC_SITE_URL=
